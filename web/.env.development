# 【开发】环境变量

# 开发服务器端口（覆盖 .env，须与 start.ps1 一致）
VITE_PORT = 5173

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 请求基础路径（后端以 /admin 开头）
VITE_API_URL = /

# 代理目标地址（指向后端服务地址）
VITE_API_PROXY_URL = http://localhost:4096

# Delete console
VITE_DROP_CONSOLE = false

# OPC 资料真实性校验 Mock（OCR/三要素/手机实名），开发阶段保持 true
VITE_COMPLIANCE_VERIFY_MOCK = true

# 打包输出目录（开发环境输出到本地 dist）
VITE_OUT_DIR = dist