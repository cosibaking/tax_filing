# Docker 部署环境变量（复制为 .env 后修改）
# cp .env.docker.example .env

# 部署模式由 compose 文件决定，此处仅作说明：
#   开发：docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build
#   线上：docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# ---------- MySQL ----------
# root 仅用于容器初始化/运维，应用连接使用 MYSQL_USER
MYSQL_ROOT_PASSWORD=change-me-mysql-root
MYSQL_DATABASE=opc_compliance
MYSQL_USER=tax_filing_app
# 密码勿含 , @ # / : 等特殊字符（会写入 DATABASE_URL，未编码会导致连接失败）
MYSQL_PASSWORD=change-me-app-password

# 应用子路径（构建时写入，须与 Nginx location 一致，勿随意修改）
# NEXT_PUBLIC_BASE_PATH=/tax_filing

# 外网访问地址（含 /tax_filing 路径，用于媒体防盗链等）
NEXT_PUBLIC_APP_URL=https://your-domain.com/tax_filing

NEXTAUTH_SECRET=change-me-in-production-min-32-chars
JWT_SECRET=change-me-jwt-secret-min-32-chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CRON_SECRET=change-me-cron-secret

SMS_PROVIDER=mock
STORAGE_PROVIDER=local
COMPLIANCE_COST_RATIO_THRESHOLD=0.8
LEGAL_TERMS_VERSION=1.0
LEGAL_PRIVACY_VERSION=1.0

# 仅开发模式生效（DEPLOY_MODE=dev）
SEED_RANDOM_MEMBERS=8
SEED_RANDOM_PASSWORD=test123

# Nginx 对外端口
NGINX_HTTP_PORT=80
